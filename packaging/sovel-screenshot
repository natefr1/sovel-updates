#!/usr/bin/python3
"""Win+Shift+S: select, save and copy an actual Wayland screen region."""
from pathlib import Path
import datetime,fcntl,json,os,re,subprocess,tempfile
runtime=Path(os.environ['XDG_RUNTIME_DIR'])
lock=(runtime/'sovel-screenshot.lock').open('w')
try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
except BlockingIOError:raise SystemExit(0)
region=subprocess.run(['slurp','-d','-b','#00000088','-c','#D9B9FFFF','-w','2'],capture_output=True,text=True)
if region.returncode:raise SystemExit(0)
geometry=region.stdout.strip()
if not re.fullmatch(r'-?\d+,-?\d+ [1-9]\d*x[1-9]\d*',geometry):raise SystemExit('Invalid screenshot selection')
pictures=subprocess.run(['xdg-user-dir','PICTURES'],capture_output=True,text=True,check=True).stdout.strip()
folder=Path(pictures or str(Path.home()/'Pictures'))/'Screenshots';folder.mkdir(parents=True,exist_ok=True)
filename=folder/('Screenshot '+datetime.datetime.now().strftime('%Y-%m-%d %H-%M-%S-%f')+'.png')
descriptor,temporary=tempfile.mkstemp(prefix='.sovel-',suffix='.png',dir=folder);os.close(descriptor)
try:
 subprocess.run(['grim','-g',geometry,'-t','png',temporary],check=True)
 os.replace(temporary,filename)
 with filename.open('rb') as image:subprocess.run(['wl-copy','--type','image/png'],stdin=image,check=True)
 subprocess.run(['notify-send','--app-name=Sovel','--expire-time=5000','--icon='+str(filename),'Screenshot copied',str(filename)],check=False)
 print(json.dumps({'saved':str(filename),'geometry':geometry,'copied':True}),flush=True)
finally:
 Path(temporary).unlink(missing_ok=True)
