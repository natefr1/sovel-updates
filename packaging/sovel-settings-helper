 for base in roots:
  if not base.is_dir():continue
  for file in sorted(base.rglob('*.desktop')):
   identifier=str(file.relative_to(base)).replace('/','-')
   if identifier in result:continue
   try:
    if file.stat().st_size>65536:continue
