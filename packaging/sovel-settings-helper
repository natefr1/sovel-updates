def command(args,timeout=5,check=False):
 try:result=subprocess.run(args,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,env=ENV,timeout=timeout,text=True)
 except (OSError,subprocess.TimeoutExpired):
  if check:raise ValueError('The supporting service did not respond. Retry when available.')
  return ''
 if len(result.stdout)>1024*1024:raise ValueError('The service returned too much data.')
 if check and result.returncode:raise ValueError(result.stderr.strip()[:300] or 'The service did not accept the request.')
 return result.stdout.strip()

