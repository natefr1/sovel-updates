 dark=mode!='light'
 if mode=='automatic':dark=not 7<=datetime.datetime.now().hour<19
 if private_mode():dark=True
 palette=gtk_palette(dark,validated['appearance.accent'])
 config_home=Path(os.environ.get('XDG_CONFIG_HOME',Path.home()/'.config'))
